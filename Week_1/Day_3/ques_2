class Solution {
public:
    vector<int> sortedSquares(vector<int>& nums) {
        int left = 0;
        int right = nums.size() - 1;
        int pos = nums.size() - 1;
        vector<int> result(nums.size());
        
        while (left <= right) {
            int l = nums[left] * nums[left];
            int r = nums[right] * nums[right];
            
            if (l > r) {
                result[pos] = l;
                left++;
            } else {
                result[pos] = r;
                right--;
            }
            pos--;
        }
        
        return result;
    }
};